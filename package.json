{
  "name": "battlelayer",
  "version": "0.4.0",
  "description": "Transparent tabletop effects overlay",
  "author": "Labstack-Developer",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.labstack.battlelayer",
    "productName": "BattleLayer",
    "files": [
      "index.html",
      "app.js",
      "style.css",
      "desktop-ui.js",
      "desktop/**/*",
      "package.json",
      "spell-fx.js"
    ],
    "win": {
      "target": "portable"
    },
    "artifactName": "BattleLayer-${version}-portable.${ext}"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Labstack-Developer/BattleLayer.git"
  },
  "bugs": {
    "url": "https://github.com/Labstack-Developer/BattleLayer/issues"
  }
}
